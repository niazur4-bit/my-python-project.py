# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- Core ---
SECRET_KEY=change-this-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# Set USE_POSTGRES=True to use PostgreSQL (recommended for production).
# Leave as False to use the bundled SQLite database for quick local development.
USE_POSTGRES=False
DB_NAME=ca_firm_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# --- Email (SMTP) ---
# In DEBUG mode, emails print to the console unless FORCE_SMTP=True.
FORCE_SMTP=False
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Munib and Co <noreply@munibandco.com>
FIRM_NOTIFICATION_EMAIL=info@munibandco.com

# --- Site ---
SITE_DOMAIN=http://127.0.0.1:8000

# --- Google Maps ---
# Paste the "src" URL from a Google Maps > Share > Embed a map iframe.
GOOGLE_MAPS_EMBED_SRC=
